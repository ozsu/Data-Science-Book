	date-modified = {2022-06-05 14:25:40 -0400},
	doi = {10.1109/JBHI.2019.2929264},
	issn = {2168-2208 (Electronic); 2168-2194 (Linking)},
	journal = IEEEJBHI,
	keywords = {Algorithms; Alzheimer Disease/*diagnostic imaging; Humans; *Neural Networks, Computer; Survival Analysis},
