@article{Sarfaraz:2022aa,
	author = {Sarfaraz, M. Umer and Hall, Damon M. and Rotman, Robin M.},
	date-added = {2025-08-10 22:17:51 -0400},
	date-modified = {2025-08-10 22:17:59 -0400},
	doi = {10.3389/frwa.2022.982605},
	issn = {2624-9375},
	journal = {Frontiers in Water},
	title = {Data sharing in transboundary water management},
	url = {https://www.frontiersin.org/journals/water/articles/10.3389/frwa.2022.982605},
	volume = {4},
	year = {2022},
	abstract = {Half the world's population resides within 310 transboundary lake and river basins shared among 151 riparian nations. Approximately 60\% of these basins lack cooperative frameworks to share water. The complexities of sharing water necessitate identifying approaches for managing transboundary international freshwater resources. While much has been written about the histories, theory, and mechanisms of transboundary water management, conflict, and cooperation among riparian nations, we draw attention to scholarship written about what we believe is the central tool for cooperation: data and data sharing. The 1997 United Nations' Convention on the Law of the Non-Navigational Uses of International Watercourses (UN Watercourse Convention) recognizes sharing water resources data is vital to river basin cooperation. Data sharing builds trust between riparian states, aids in mitigating conflict, and improves environmental, economic, and social outcomes. Despite calls to increase data sharing in transboundary basins to support cooperative management, few papers review the role of data sharing in transboundary water management, including how often and what types of water resources data and information are shared. We synthesize the role of data in conflict and collaboration from peer-reviewed papers on transboundary water management from the year the UN Watercourse Convention went into force, 2014 to May 2022. We outline what scholars argue are the types of water-related data to be shared, the frequency of data sharing, and the mechanisms for sharing data for facilitating cooperation in transboundary waters.},
	bdsk-url-1 = {https://www.frontiersin.org/journals/water/articles/10.3389/frwa.2022.982605},
	bdsk-url-2 = {https://doi.org/10.3389/frwa.2022.982605}}

@article{Obada:2025aa,
	author = {Obada, Ez{\'e}chiel and Biao, E. I. and Zohou, P. J. and Yarou, H. and Hounnondaho, F. Z. and Alamou, E. A.},
	date-added = {2025-08-10 22:16:22 -0400},
	date-modified = {2025-08-10 22:16:23 -0400},
	doi = {10.2166/nh.2025.133},
	eprint = {https://iwaponline.com/hr/article-pdf/56/2/153/1538691/nh2025133.pdf},
	issn = {0029-1277},
	journal = {Hydrology Research},
	number = {2},
	pages = {153-166},
	title = {Using machine learning and satellite data to improve flood forecasting: the case of the Ou{\'e}m{\'e} basin at the B{\'e}t{\'e}rou outlet},
	url = {https://doi.org/10.2166/nh.2025.133},
	volume = {56},
	year = {2025},
	abstract = {Flooding is a major concern for the scientific community, and it has been exacerbated by climate change. Accurate prediction of these extreme events is crucial for adequate preparedness. This study investigates the potential of advanced artificial intelligence (AI) techniques to enhance the accuracy of flood prediction and provide actionable insights for flood management. This study focuses on the African context, where data are scarce and the weak capacity of governments to react to floods makes populations vulnerable. It adopted advanced recurrent neural network architectures such as the long short-term memory (LSTM) and the convolutional long short-term memory (ConvLSTM) models, focusing on hydrological modeling innovation. The results indicated a high performance of these models in simulated runoff. The coefficient of determination (R2) and Nash--Sutcliffe efficiency between observed and simulated runoff are approximately 0.96 and 0.95, respectively, for the ConvLSTM model and 0.95 and 0.95 for the LSTM model. This study generated the flooding risk area maps. These maps represent a significant decision-making tool for flood management. This research confirms the effectiveness of deep learning in hydrology and proposes an innovative methodological framework for sustainable water resource management in the African context.},
	bdsk-url-1 = {https://doi.org/10.2166/nh.2025.133}}

@inproceedings{Nikhil:2023aa,
	author = {Nikhil and Arpna and Dalal, Surjeet},
	booktitle = SmartTechCon23,
	date-added = {2025-08-10 22:11:43 -0400},
	date-modified = {2025-08-10 22:14:14 -0400},
	doi = {10.1109/SmartTechCon57526.2023.10391668},
	keywords = {Support vector machines;Systematics;Recurrent neural networks;Machine learning algorithms;Biological system modeling;Water quality;Machine learning;water quality evaluation;machine learning;systematic review;prediction models;feature selection;performance evaluation},
	pages = {1013-1018},
	title = {Machine learning model for Water Quality evaluation: Systematic Review},
	year = {2023},
	abstract = {Evaluating water quality is essential to maintaining healthy ecosystems and providing safe drinking water. There has been a rise in enthusiasm for creating models for evaluating water quality thanks to the development of machine learning methods. In order to highlight the most important results and trends in the field of water quality evaluation, this systematic review seeks to offer an overview of the most advanced machine learning models currently in use. Relevant papers published during [detailed time period] were included after a thorough search of electronic resources. The studies were chosen because of their comprehensive coverage of a wide variety of water types and characteristics, including pH, dissolved oxygen, turbidity, and nutrient concentrations, across a wide range of water sources (rivers, lakes, reservoirs, and groundwater). This overview sheds light on the wide variety of machine learning algorithms used in water quality assessment. These algorithms range from the more traditional support vector machines (SVM) to deep learning models like convolutional neural networks (CNN) and recurrent neural networks (RNN). Water quality metrics and pollution sources may now be correctly predicted using these models. This review also delves into the physicochemical characteristics, meteorological data, topographical qualities, and remote sensing data that go into making these models work. There has been encouraging progress toward better water quality prediction models thanks in part to the inclusion of more data sources. Accuracy, precision, recall, and correlation coefficients are only few of the performance evaluation criteria studied here. In particular, it highlights data shortages, data quality concerns, and model interpretability as bottlenecks in the creation and rollout of machine learning models for water quality evaluation. Future research recommendations are suggested in light of the findings of the systematic review. The creation of interpretable models, consistent data collecting and sharing processes, and improved stakeholder comprehension and confidence in the outcomes are all areas that need attention. This systematic review's findings help further the use of machine learning techniques to the evaluation of water quality. They provide light on the present state of the art, point out research gaps, and offer advice to academics, policymakers, and water resource managers on how to best use machine learning to manage and conserve water quality.},
	bdsk-url-1 = {https://doi.org/10.1109/SmartTechCon57526.2023.10391668}}

@article{Bollen:2021aa,
	author = {Bollen, Erik and Hendrix, Rik and Kuijpers, Bart and Vaisman, Alejandro},
	date-added = {2025-08-10 21:57:04 -0400},
	date-modified = {2025-08-10 21:57:26 -0400},
	doi = {https://doi.org/10.1111/tgis.12801},
	eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/tgis.12801},
	journal = {Trans. GIS},
	number = {6},
	pages = {2907-2938},
	title = {Towards the Internet of Water: Using graph databases for hydrological analysis on the Flemish river system},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/tgis.12801},
	volume = {25},
	year = {2021},
	abstract = {Abstract The ``Internet of Water'' project will deploy 2,500 sensors along the Flemish river system, in Belgium. These sensors will be part of a monitoring system. This will produce an enormous amount of data, on which prediction and analysis tasks can be performed. To represent, store, and query river data, relational databases are normally used. However, this choice introduces an ``impedance mismatch'' between the conceptual representation (typically a graph) and the storage model (relational tables). To solve this problem, this article proposes to use graph databases. The Flemish river system is presented as a use case and the Neo4j graph database and its high-level query language, Cypher, are used for storing and querying the data, respectively. A relational alternative is implemented over the PostgreSQL database. A collection of representative queries of interest for hydrologists is defined over both database implementations.},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1111/tgis.12801},
	bdsk-url-2 = {https://doi.org/10.1111/tgis.12801}}

