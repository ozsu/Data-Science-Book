@inproceedings{Giebler:2019aa,
	address = {Berlin, Heidelberg},
	author = {Giebler, Corinna and Gr\"{o}ger, Christoph and Hoos, Eva and Schwarz, Holger and Mitschang, Bernhard},
	booktitle = {Proc. 21st Intl. Conf. on Big Data Analytics and Knowledge Discovery},
	date-added = {2025-05-22 10:10:38 -0400},
