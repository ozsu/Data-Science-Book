	isbn = {2731-9814},
	journal = {npj Climate Action},
	number = {1},
	pages = {74},
	title = {Advances in complex climate change risk assessment for adaptation},
	url = {https://doi.org/10.1038/s44168-025-00281-y},
	volume = {4},
	year = {2025},
	abstract = {Recent advances in climate change risk assessment and management and their application across cities, coastal zones, and finance highlight promising opportunities for near-term action to better govern complex climate change risk and advance adaptation implementation. Positioning applications of participatory modeling, climate risk assessment, adaptation pathways planning, and systemic fiscal disaster risk modeling across variations in time, space, and sector, examples point towards more actionable insights and governance conditions to accelerate equitable adaptation and address inaction caused by uncertainty and complexity.},
