@inproceedings{Abdulla:2024aa,
	author = {Abdulla, Yaqoob Yusuf and Al-Alawi, Adel Ismail},
	booktitle = {2024 ASU Intl. Conf. in Emerging Technologies for Sustainability and Intelligent Systems},
	date-added = {2025-08-19 22:05:40 -0400},
	date-modified = {2025-08-19 22:06:13 -0400},
	doi = {10.1109/ICETSIS61505.2024.10459536},
	keywords = {Deep learning;Ethics;Systematics;Machine learning algorithms;Statistical analysis;Bibliographies;Market research;FRM;ML;LSTM & DL},
	pages = {531-535},
	title = {Advances in Machine Learning for Financial Risk Management: A Systematic Literature Review},
	year = {2024},
	abstract = {Financial risk management is evolving rapidly with the integration of machine learning techniques, which offer sophisticated tools for managing complex and interconnected financial systems. Its crucial role in risk identification, assessment, mitigation, and prediction accounts for its significance. This systematic literature review analyzes the utilization of machine learning in financial risk management across 15 scholarly papers. The papers were selected from reputable journals available on databases such as ScienceDirect and IEEE. Only papers published during the last five years were selected to ensure their relevance. The selected papers include various machine learning algorithms, such as neural networks, deep learning, and ensemble methods, applied to financial risks such as credit, market, liquidity, and systemic risks. The research uses multiple methodologies, including but not limited to quantitative, empirical, and computational modeling approaches. The findings of the comparative analysis reveal that machine learning techniques are more effective and adaptive than traditional statistical methods at managing intricate risk patterns across a range of financial risk domains. Additionally, there is a clear trend toward leveraging big data and advanced analytics to enhance financial risk management practices. Academics and decision-makers from various industries can get valuable insights from the synthesis of existing literature, which will improve their comprehension of the progress in the financial risk management process utilizing machine learning techniques.},
	bdsk-url-1 = {https://doi.org/10.1109/ICETSIS61505.2024.10459536}}

@article{Arifovic:2022aa,
	author = {Jasmina Arifovic and Xue-zhong He and Lijian Wei},
	date-added = {2025-08-19 22:25:12 -0400},
	date-modified = {2025-08-19 22:25:22 -0400},
	doi = {https://doi.org/10.1016/j.jedc.2022.104438},
	issn = {0165-1889},
	journal = {J. Economic Dynamics and Control},
	keywords = {High-frequency trading, Price efficiency, Machine learning, Genetic algorithm, Limit order market},
	pages = {104438},
	title = {Machine learning and speed in high-frequency trading},
	url = {https://www.sciencedirect.com/science/article/pii/S0165188922001439},
	volume = {139},
	year = {2022},
	abstract = {The creative destruction wrought by high-frequency algorithmic trading has raised increasing concerns about the effect of machine learning behaviors and ultra high-frequency trading on financial markets. By employing a genetic algorithm with a classifier system as an adaptive learning tool, we address some of these concerns by studying a dynamic limit order market model with asymmetric information and varying speeds of high-frequency trading (HFT). We show that HFT benefits uninformed traders, improves information efficiency but reduces market liquidity. We find that there is a trade-off where a competition effect erodes the information and speed advantages of high-frequency traders, increasing trading speeds of HF traders reduces market liquidity but generates a hump-shaped relationship to the profitability of high-frequency traders and information efficiency. This research finds there may be potential benefits to throttling the trading speed arms race to improve market efficiency. We also find that strategic algorithmic trading compensates for diminishments in speed advantages, providing an insight on machine behavior in the FinTech age.},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0165188922001439},
	bdsk-url-2 = {https://doi.org/10.1016/j.jedc.2022.104438}}

