	isbn = {1471-2105},
	journal = BMCBIOINF,
	number = {1},
	pages = {54},
	title = {Integrated analysis of gene expression by association rules discovery},
	url = {https://doi.org/10.1186/1471-2105-7-54},
	volume = {7},
	year = {2006},
	abstract = {Microarray technology is generating huge amounts of data about the expression level of thousands of genes, or even whole genomes, across different experimental conditions. To extract biological knowledge, and to fully understand such datasets, it is essential to include external biological information about genes and gene products to the analysis of expression data. However, most of the current approaches to analyze microarray datasets are mainly focused on the analysis of experimental data, and external biological information is incorporated as a posterior process},
	bdsk-url-1 = {https://doi.org/10.1186/1471-2105-7-54}}

@article{Srivastava:2000aa,
