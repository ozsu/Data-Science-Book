@article{Trok:2024aa,
	author = {Jared T. Trok and Elizabeth A. Barnes and Frances V. Davenport and Noah S. Diffenbaugh},
	date-added = {2025-08-09 10:57:23 -0400},
	date-modified = {2025-08-09 10:57:25 -0400},
	doi = {10.1126/sciadv.adl3242},
	eprint = {https://www.science.org/doi/pdf/10.1126/sciadv.adl3242},
	journal = {Science Advances},
	number = {34},
	pages = {eadl3242},
	title = {Machine learning--based extreme event attribution},
	url = {https://www.science.org/doi/abs/10.1126/sciadv.adl3242},
	volume = {10},
	year = {2024},
	abstract = {The observed increase in extreme weather has prompted recent methodological advances in extreme event attribution. We propose a machine learning--based approach that uses convolutional neural networks to create dynamically consistent counterfactual versions of historical extreme events under different levels of global mean temperature (GMT). We apply this technique to one recent extreme heat event (southcentral North America 2023) and several historical events that have been previously analyzed using established attribution methods. We estimate that temperatures during the southcentral North America event were 1.18$\,^{\circ}$ to 1.42$\,^{\circ}$C warmer because of global warming and that similar events will occur 0.14 to 0.60 times per year at 2.0$\,^{\circ}$C above preindustrial levels of GMT. Additionally, we find that the learned relationships between daily temperature and GMT are influenced by the seasonality of the forced temperature response and the daily meteorological conditions. Our results broadly agree with other attribution techniques, suggesting that machine learning can be used to perform rapid, low-cost attribution of extreme events. Machine learning is used to quantify the influence of human activity on the frequency and intensity of extreme heat events.},
	bdsk-url-1 = {https://www.science.org/doi/abs/10.1126/sciadv.adl3242},
	bdsk-url-2 = {https://doi.org/10.1126/sciadv.adl3242}}

